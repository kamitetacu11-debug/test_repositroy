# TaskMaster Backend Environment Variables

# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskmaster?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGINS="http://localhost:3001,http://localhost:8081"

# Logging
LOG_LEVEL="info"

# OpenAI (optional, for AI features)
OPENAI_API_KEY=""

# S3 Storage (optional)
S3_BUCKET=""
S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
