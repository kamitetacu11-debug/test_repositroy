# TaskMaster Security Environment Variables
# Copy this file to .env and customize the values

# ============================================================================
# CAPTCHA Configuration
# ============================================================================

# CAPTCHA Provider: recaptcha | hcaptcha | turnstile | disabled
CAPTCHA_PROVIDER=disabled

# reCAPTCHA v3 Configuration (https://www.google.com/recaptcha/admin)
# CAPTCHA_PROVIDER=recaptcha
# CAPTCHA_SITE_KEY=your-recaptcha-site-key
# CAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# hCaptcha Configuration (https://dashboard.hcaptcha.com)
# CAPTCHA_PROVIDER=hcaptcha
# CAPTCHA_SITE_KEY=your-hcaptcha-site-key
# CAPTCHA_SECRET_KEY=your-hcaptcha-secret-key

# Cloudflare Turnstile Configuration (https://dash.cloudflare.com)
# CAPTCHA_PROVIDER=turnstile
# CAPTCHA_SITE_KEY=your-turnstile-site-key
# CAPTCHA_SECRET_KEY=your-turnstile-secret-key

# Score threshold for reCAPTCHA v3 (0.0 - 1.0, higher is stricter)
CAPTCHA_SCORE_THRESHOLD=0.5

# ============================================================================
# Rate Limiting Configuration
# ============================================================================

# Maximum requests per time window
RATE_LIMIT_MAX=100

# Time window in milliseconds (default: 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# ============================================================================
# Brute Force Protection
# ============================================================================

# Maximum failed login attempts before lockout
BRUTE_FORCE_MAX_ATTEMPTS=5

# Lockout duration in minutes
BRUTE_FORCE_LOCKOUT_MINUTES=15

# ============================================================================
# JWT Configuration
# ============================================================================

# Strong secret key for JWT signing (change in production!)
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiration (default: 7 days)
JWT_EXPIRES_IN=7d

# ============================================================================
# CORS Configuration
# ============================================================================

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# ============================================================================
# Logging
# ============================================================================

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ============================================================================
# Production Recommendations
# ============================================================================

# 1. Use strong, unique JWT_SECRET (64+ characters)
# 2. Enable CAPTCHA for production (recaptcha or hcaptcha)
# 3. Set stricter rate limits based on your traffic patterns
# 4. Use HTTPS only (configure in nginx/load balancer)
# 5. Enable HSTS in production
# 6. Review and adjust brute force settings
# 7. Set up monitoring and alerting
# 8. Regular security audits
